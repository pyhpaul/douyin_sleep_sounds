page {
  min-height: 100%;
  background: #07111f;
  color: #f7fbff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}
