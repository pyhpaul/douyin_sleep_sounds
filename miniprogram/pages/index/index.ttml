<view class="page {{pageMode === 'player' ? 'page-player' : 'page-channels'}}">
  <view class="ambient ambient-one"></view>
  <view class="ambient ambient-two"></view>

  <view class="hero compact-hero">
    <view class="hero-row">
      <view class="title">晚安声音</view>
      <view class="hero-note">选择频道，点击播放开始收听</view>
    </view>
  </view>

  <view class="main-tabs">
    <button
      class="main-tab {{pageMode === 'channels' ? 'main-tab-active' : ''}}"
      data-mode="channels"
      bindtap="handleMainTabTap"
    >
      <view class="main-tab-label">频道</view>
    </button>
    <button
      class="main-tab {{pageMode === 'player' ? 'main-tab-active' : ''}}"
      data-mode="player"
      bindtap="handleMainTabTap"
    >
      <view class="main-tab-label">播放器</view>
    </button>
  </view>

  <view tt:if="{{pageMode === 'channels'}}" class="channels-page">
    <view tt:if="{{hasSounds}}" class="radio-section">
      <scroll-view class="channel-tabs" scroll-x="true" show-scrollbar="false">
        <view class="channel-tabs-track">
          <button
            tt:for="{{soundGroupTabs}}"
            tt:key="id"
            class="channel-tab {{item.isActive ? 'channel-tab-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="handleGroupTabTap"
          >
            <image class="channel-tab-thumb" src="{{item.thumbnail}}" mode="aspectFill"></image>
            <view class="channel-tab-text">{{item.title}}</view>
          </button>
        </view>
      </scroll-view>

      <view class="group-header">
        <view class="group-meta">
          <view class="group-title">{{activeSoundGroup.title}}</view>
          <view class="group-count">{{activeSoundGroup.sounds.length}} 个场景</view>
        </view>
        <view class="group-subtitle">{{activeSoundGroup.subtitle}}</view>
      </view>

      <view class="station-list">
        <view
          tt:for="{{activeSoundGroup.sounds}}"
          tt:for-item="sound"
          tt:key="id"
          class="station-card {{sound.isActive ? 'station-card-active' : ''}}"
          data-id="{{sound.id}}"
          bindtap="handleSoundTap"
        >
          <image class="station-icon" src="{{sound.cover}}" mode="aspectFill"></image>
          <view class="station-body">
            <view class="sound-title">{{sound.title}}</view>
            <view class="sound-desc">{{sound.description}}</view>
            <view class="sound-chip-row">
              <view class="sound-tag">{{sound.category}}</view>
              <view tt:if="{{sound.unlockLabel}}" class="sound-unlock">{{sound.unlockLabel}}</view>
              <view tt:if="{{sound.isActive}}" class="sound-status">已选中</view>
              <view
                tt:if="{{sound.isPlayingItem}}"
                class="sound-status {{sound.isPlayingItem ? 'sound-status-playing' : ''}}"
              >
                播放中
              </view>
            </view>
          </view>
          <button
            class="station-play"
            data-id="{{sound.id}}"
            bindtap="handleSoundPlayTap"
          >
            播放
          </button>
        </view>
      </view>
    </view>

    <view tt:else class="empty-card">暂无可播放声音</view>
  </view>

  <view tt:if="{{pageMode === 'player'}}" class="player-page">
    <view class="player-shell">
      <view class="player-backdrop">
        <image
          tt:if="{{currentSoundCover}}"
          class="player-backdrop-image"
          src="{{currentSoundCover}}"
          mode="aspectFill"
        ></image>
        <view class="player-backdrop-shade"></view>
        <view class="player-shell-content">
          <view class="playback-panel">
            <view class="player-control-stack">
              <view class="player-copy-panel">
                <view class="now-label">当前播放</view>
                <view class="now-title">{{currentSoundTitle}}</view>
                <view class="now-desc">{{currentSoundDescription}}</view>
                <view class="now-meta">
                  <text class="pill">{{currentSoundCategoryText}}</text>
                  <text class="pill">{{playbackText}}</text>
                  <text class="pill">{{remainingText}}</text>
                </view>
              </view>

              <view class="player-options">
                <view class="option-card timer-section">
                  <view class="timer-head">
                    <view class="timer-copy">
                      <view class="timer-title">定时停止</view>
                      <view class="timer-value">{{remainingText}}</view>
                    </view>
                    <view class="transport-row">
                      <button class="primary-control" bindtap="handlePlayToggle">
                        {{isPlaying ? "暂停" : "播放"}}
                      </button>
                    </view>
                  </view>
                  <view class="timer-options">
                    <button
                      tt:for="{{timerOptions}}"
                      tt:key="minutes"
                      class="timer-chip {{item.isActive ? 'timer-chip-active' : ''}}"
                      data-minutes="{{item.minutes}}"
                      bindtap="handleTimerTap"
                    >
                      {{item.label}}
                    </button>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view tt:if="{{hasSounds && pageMode === 'channels'}}" class="mini-player">
    <view class="mini-cover-shell" bindtap="handleMiniPlayerTap">
      <image class="mini-cover" src="{{currentSoundCover}}" mode="aspectFill"></image>
    </view>
    <view class="mini-player-info" bindtap="handleMiniPlayerTap">
      <view class="mini-title">{{currentSoundTitle}}</view>
      <view class="mini-meta">{{currentSoundCategoryText}} · {{playbackText}} · {{remainingText}}</view>
    </view>
    <button class="mini-control" bindtap="handlePlayToggle">
      {{isPlaying ? "暂停" : "播放"}}
    </button>
  </view>

  <view class="footer-note">
    当前声音源来自本地配置；上线前请替换为授权音频资源。
  </view>
</view>
