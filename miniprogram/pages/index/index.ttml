<view class="page {{pageMode === 'player' ? 'page-player' : 'page-channels'}}">
  <view class="ambient ambient-one"></view>
  <view class="ambient ambient-two"></view>

  <view class="hero compact-hero">
    <view class="hero-row">
      <view class="title">晚安声音</view>
      <view class="hero-note">选择频道，快速开始播放</view>
    </view>
  </view>

  <view class="main-tabs">
    <button
      class="main-tab {{pageMode === 'channels' ? 'main-tab-active' : ''}}"
      data-mode="channels"
      bindtap="handleMainTabTap"
    >
      <view class="main-tab-label">频道</view>
    </button>
    <button
      class="main-tab {{pageMode === 'player' ? 'main-tab-active' : ''}}"
      data-mode="player"
      bindtap="handleMainTabTap"
    >
      <view class="main-tab-label">播放器</view>
    </button>
  </view>

  <view tt:if="{{pageMode === 'channels'}}" class="channels-page">
    <view tt:if="{{hasSounds}}" class="radio-section">
      <view class="channel-tabs">
        <button
          tt:for="{{soundGroupTabs}}"
          tt:key="id"
          class="channel-tab {{item.isActive ? 'channel-tab-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleGroupTabTap"
        >
          {{item.title}}
        </button>
      </view>

      <view class="group-header">
        <view class="group-title">{{activeSoundGroup.title}}</view>
        <view class="group-subtitle">{{activeSoundGroup.subtitle}}</view>
      </view>

      <view class="station-list">
        <view
          tt:for="{{activeSoundGroup.sounds}}"
          tt:for-item="sound"
          tt:key="id"
          class="station-card {{sound.isActive ? 'station-card-active' : ''}}"
          data-id="{{sound.id}}"
          bindtap="handleSoundTap"
        >
          <view class="station-icon"></view>
          <view class="station-body">
            <view class="sound-title">{{sound.title}}</view>
            <view class="sound-desc">{{sound.description}}</view>
          </view>
          <button
            class="station-play"
            data-id="{{sound.id}}"
            bindtap="handleSoundTap"
          >
            播放
          </button>
        </view>
      </view>
    </view>

    <view tt:else class="empty-card">暂无可播放声音</view>
  </view>

  <view tt:if="{{pageMode === 'player'}}" class="player-page">
    <view class="player-shell">
      <view class="album-art">
        <view class="album-glow"></view>
        <view class="album-disc {{isPlaying ? 'disc-spinning' : 'disc-idle'}}">
          <view class="album-disc-sheen"></view>
          <view class="album-disc-rings"></view>
          <view class="album-disc-label"></view>
          <view class="album-hole"></view>
        </view>
      </view>

      <view class="playback-panel">
        <view class="now-label">当前播放</view>
        <view class="now-title">{{currentSoundTitle}}</view>
        <view class="now-meta">
          <text class="pill">{{currentSoundCategoryText}}</text>
          <text class="pill">{{playbackText}}</text>
          <text class="pill">{{remainingText}}</text>
        </view>

        <view class="transport-row">
          <button class="primary-control" bindtap="handlePlayToggle">
            {{isPlaying ? "暂停" : "播放"}}
          </button>
        </view>

        <view class="player-options">
          <view class="loop-row">
            <view>
              <view class="loop-title">循环播放</view>
              <view class="loop-desc">当前声音结束后自动重播</view>
            </view>
            <switch checked="{{isLooping}}" bindchange="handleLoopChange" color="#f4c77a" />
          </view>

          <view class="timer-section">
            <view class="timer-title">定时停止</view>
            <view class="timer-options">
              <button
                tt:for="{{timerOptions}}"
                tt:key="minutes"
                class="timer-chip {{item.isActive ? 'timer-chip-active' : ''}}"
                data-minutes="{{item.minutes}}"
                bindtap="handleTimerTap"
              >
                {{item.label}}
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view tt:if="{{hasSounds && pageMode === 'channels'}}" class="mini-player">
    <view class="mini-disc-shell">
      <view class="mini-disc {{isPlaying ? 'disc-spinning' : 'disc-idle'}}">
        <view class="mini-disc-sheen"></view>
        <view class="mini-disc-rings"></view>
        <view class="mini-disc-label"></view>
        <view class="mini-disc-hole"></view>
      </view>
    </view>
    <view class="mini-player-info" bindtap="handleMiniPlayerTap">
      <view class="mini-title">{{currentSoundTitle}}</view>
      <view class="mini-meta">{{playbackText}} · {{remainingText}}</view>
    </view>
    <button class="mini-control" bindtap="handlePlayToggle">
      {{isPlaying ? "暂停" : "播放"}}
    </button>
  </view>

  <view class="footer-note">
    当前声音源来自本地配置；上线前请替换为授权音频资源。
  </view>
</view>
