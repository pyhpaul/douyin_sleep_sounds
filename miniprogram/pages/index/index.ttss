.page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  padding: 36rpx 32rpx 76rpx;
  background:
    radial-gradient(circle at 50% -12%, rgba(244, 199, 122, 0.22), transparent 34%),
    radial-gradient(circle at 92% 18%, rgba(107, 128, 255, 0.20), transparent 30%),
    linear-gradient(180deg, #080b13 0%, #111827 48%, #070a10 100%);
}

.page-channels {
  padding-bottom: 184rpx;
}

.page-player {
  padding-bottom: 72rpx;
}

.ambient {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.ambient-one {
  top: 148rpx;
  left: -120rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(244, 199, 122, 0.12);
  filter: blur(12rpx);
}

.ambient-two {
  right: -160rpx;
  top: 520rpx;
  width: 360rpx;
  height: 360rpx;
  background: rgba(91, 110, 255, 0.14);
  filter: blur(12rpx);
}

.hero,
.main-tabs,
.channels-page,
.player-page,
.footer-note {
  position: relative;
  z-index: 1;
}

.compact-hero {
  margin-bottom: 22rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  color: #fff8ea;
  flex: 0 0 auto;
  font-size: 46rpx;
  font-weight: 700;
}

.hero-note {
  color: rgba(255, 248, 234, 0.62);
  font-size: 24rpx;
  line-height: 1.4;
  text-align: right;
}

.main-tabs {
  display: flex;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
}

.main-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  color: rgba(255, 248, 234, 0.58);
  font-size: 28rpx;
  font-weight: 650;
}

.main-tab-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  text-align: center;
}

.main-tab-active {
  background: linear-gradient(135deg, rgba(244, 199, 122, 0.94), rgba(255, 225, 163, 0.86));
  color: #17120a;
}

.channels-page,
.player-page {
  margin-top: 30rpx;
}

.radio-section,
.player-shell,
.empty-card {
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 38rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.055));
  box-shadow: 0 30rpx 96rpx rgba(0, 0, 0, 0.30);
}

.radio-section {
  padding: 26rpx;
}

.channel-tabs {
  height: 116rpx;
  margin-bottom: 26rpx;
  white-space: nowrap;
}

.channel-tabs-track {
  display: flex;
  padding-right: 12rpx;
}

.channel-tab {
  flex: 0 0 136rpx;
  width: 136rpx;
  min-width: 136rpx;
  margin-right: 12rpx;
  padding: 12rpx 12rpx 14rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.075);
  color: rgba(255, 248, 234, 0.64);
  font-size: 24rpx;
  font-weight: 650;
}

.channel-tab-active {
  background: rgba(244, 199, 122, 0.20);
  color: #fff8ea;
  box-shadow: inset 0 0 0 1rpx rgba(244, 199, 122, 0.28);
}

.channel-tab-thumb {
  display: block;
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 10rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
}

.channel-tab-text {
  text-align: center;
  white-space: nowrap;
}

.group-header {
  margin-bottom: 20rpx;
}

.group-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.group-title {
  color: #fff8ea;
  font-size: 36rpx;
  font-weight: 750;
}

.group-count {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 248, 234, 0.62);
  font-size: 20rpx;
  line-height: 1;
}

.group-subtitle {
  margin-top: 8rpx;
  color: rgba(255, 248, 234, 0.50);
  font-size: 24rpx;
  line-height: 1.4;
}

.station-list {
  display: flex;
  flex-direction: column;
}

.station-card {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.06);
}

.station-card-active {
  border-color: rgba(244, 199, 122, 0.70);
  background: linear-gradient(135deg, rgba(244, 199, 122, 0.20), rgba(255, 255, 255, 0.06));
  box-shadow: inset 0 0 0 1rpx rgba(244, 199, 122, 0.10);
}

.station-icon {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  margin-right: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.12);
}

.station-body {
  flex: 1;
  min-width: 0;
}

.sound-title {
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
}

.sound-desc {
  margin-top: 8rpx;
  color: rgba(255, 248, 234, 0.52);
  font-size: 23rpx;
  line-height: 1.42;
}

.sound-tag {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 248, 234, 0.66);
  font-size: 20rpx;
  line-height: 1;
}

.sound-chip-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.sound-unlock,
.sound-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.sound-unlock {
  background: rgba(125, 141, 255, 0.12);
  color: rgba(223, 229, 255, 0.88);
}

.sound-status {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 248, 234, 0.62);
}

.sound-status-playing {
  background: rgba(244, 199, 122, 0.18);
  color: #fff4dc;
}

.station-play {
  flex: 0 0 auto;
  min-width: 100rpx;
  margin-left: 18rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(255, 225, 163, 0.92), rgba(244, 199, 122, 0.76));
  color: #17120a;
  font-size: 23rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(244, 199, 122, 0.14);
}

.player-shell {
  position: relative;
  overflow: hidden;
  padding: 0;
}

.player-backdrop {
  position: relative;
  min-height: 980rpx;
}

.player-backdrop-image,
.player-backdrop-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.player-backdrop-image {
  transform: scale(1.04);
}

.player-backdrop-shade {
  background:
    linear-gradient(180deg, rgba(7, 10, 16, 0.08), rgba(7, 10, 16, 0.22) 24%, rgba(7, 10, 16, 0.72) 58%, rgba(7, 10, 16, 0.94) 100%),
    radial-gradient(circle at 50% 10%, rgba(255, 255, 255, 0.12), transparent 28%);
}

.player-shell-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  min-height: 980rpx;
  box-sizing: border-box;
  padding: 36rpx 28rpx 32rpx;
}

.playback-panel {
  width: 100%;
  text-align: center;
}

.player-control-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.player-copy-panel {
  box-sizing: border-box;
  padding: 26rpx 24rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(12, 16, 25, 0.18), rgba(12, 16, 25, 0.56));
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.16);
  text-align: left;
}

.now-label {
  color: rgba(255, 248, 234, 0.44);
  font-size: 23rpx;
}

.now-title {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
  text-shadow: 0 10rpx 32rpx rgba(0, 0, 0, 0.28);
}

.now-desc {
  margin-top: 12rpx;
  color: rgba(255, 248, 234, 0.64);
  font-size: 24rpx;
  line-height: 1.52;
}

.now-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  margin-top: 20rpx;
}

.pill {
  display: inline-flex;
  margin: 0 8rpx 12rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 199, 122, 0.10);
  color: rgba(255, 248, 234, 0.74);
  font-size: 23rpx;
}

.transport-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 0;
}

.primary-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffe1a3, #f4c77a);
  color: #17120a;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(244, 199, 122, 0.20);
}

.player-options {
  margin-top: 0;
  text-align: left;
}

.option-card {
  padding: 22rpx 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 26rpx;
  background: linear-gradient(180deg, rgba(12, 16, 25, 0.32), rgba(12, 16, 25, 0.62));
  box-shadow: 0 20rpx 56rpx rgba(0, 0, 0, 0.18);
}

.timer-title {
  color: #fff8ea;
  font-size: 28rpx;
  font-weight: 600;
}

.timer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.timer-copy {
  flex: 1;
  min-width: 0;
}

.timer-section {
  margin-top: 0;
}

.timer-value {
  margin-top: 8rpx;
  color: rgba(255, 248, 234, 0.56);
  font-size: 23rpx;
}

.timer-options {
  display: flex;
  flex-wrap: nowrap;
  margin-top: 16rpx;
  overflow: hidden;
}

.timer-chip {
  flex: 1;
  min-width: 0;
  margin-right: 10rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.075);
  color: rgba(255, 248, 234, 0.68);
  font-size: 22rpx;
  text-align: center;
}

.timer-chip:last-child {
  margin-right: 0;
}

.timer-chip-active {
  background: rgba(244, 199, 122, 0.22);
  color: #ffffff;
}

.mini-player {
  position: fixed;
  z-index: 10;
  right: 32rpx;
  bottom: 28rpx;
  left: 32rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 30rpx;
  background: rgba(14, 18, 29, 0.96);
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.40);
}

.mini-cover-shell {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  margin-right: 18rpx;
}

.mini-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
}

.mini-player-info {
  flex: 1;
  min-width: 0;
}

.mini-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.mini-meta {
  margin-top: 6rpx;
  color: rgba(255, 248, 234, 0.52);
  font-size: 22rpx;
}

.mini-control {
  flex: 0 0 auto;
  min-width: 100rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: #f4c77a;
  color: #17120a;
  font-size: 23rpx;
  font-weight: 750;
}

.empty-card {
  margin-top: 36rpx;
  padding: 40rpx;
  border-radius: 30rpx;
  color: rgba(255, 248, 234, 0.70);
  text-align: center;
}

.footer-note {
  margin-top: 34rpx;
  color: rgba(255, 248, 234, 0.34);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}
